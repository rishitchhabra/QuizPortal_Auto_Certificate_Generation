# Server port (default: 3001)
PORT=3001

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:YOUR_PASSWORD_HERE@localhost:5432/certificate

# Set to 'true' if your PostgreSQL requires SSL (e.g. cloud-hosted DB)
DB_SSL=false

# PostgreSQL pool size per process
# PG_POOL_MAX=10

# Basic auth credentials for the /admin-ui server dashboard
ADMIN_USER=admin
ADMIN_PASS=admin

# ===== BullMQ / Redis (certificate queue) =====
# Redis connection string used by BOTH the API (producer) and worker (consumer).
# Supports credentials and db: redis://user:pass@host:6379/0
REDIS_URL=redis://127.0.0.1:6379

# Set to 'true' for TLS (managed Redis like Upstash/AWS ElastiCache)
# REDIS_TLS=false
# REDIS_PASSWORD=

# How many certificate jobs each worker process runs concurrently (3-4 on a 2 vCPU VPS)
WORKER_CONCURRENCY=3

# Max retry attempts per job before it is marked FAILED
JOB_MAX_ATTEMPTS=3

# ===== LibreOffice =====
# Absolute path to the soffice binary if it is not on PATH
# SOFFICE_PATH=/usr/bin/soffice
# SOFFICE_TIMEOUT_MS=60000

# ===== Transient certificate storage =====
# Generated PDFs/preview PNGs live here only until downloaded or expired (never permanent)
# STORAGE_DIR=/var/www/quiz.gispilibhit.com/storage/certificates
# STORAGE_TTL_MS=3600000
